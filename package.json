{
  "name": "interview-reviewer",
  "private": true,
  "version": "0.1.0",
  "description": "Interview Reviewer - client (React/Vite) + server (FastAPI)",
  "scripts": {
    "start": "npm run build && concurrently -k --names server,client --prefix-colors cyan,green \"npm:start:server\" \"npm:start:client\"",
    "start:server": "uv --directory server run interview-reviewer",
    "start:client": "npm --prefix client run preview",
    "dev": "concurrently -k --names server,client --prefix-colors cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "uv --directory server run uvicorn interview_reviewer.entrypoints.api.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}